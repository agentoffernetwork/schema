{
  "version": "v1.0",
  "offer_types": [
    "physical_product",
    "digital_goods",
    "content",
    "online_service",
    "offline_service"
  ],
  "valid_constraints": [
    {},
    { "offer_types": [] },
    { "listing_source_names": [] },
    { "offer_types": ["physical_product", "digital_goods"] },
    { "listing_source_names": ["Amazon"] },
    { "listing_source_names": ["Amazon "] },
    { "listing_source_names": ["Amazon", " amazon ", "AMAZON\t"] },
    { "listing_source_names": ["Amazon\t"] },
    { "listing_source_names": ["Amazon\n"] },
    { "listing_source_names": ["Amazon\u000b"] },
    { "listing_source_names": ["Amazon\f"] },
    { "listing_source_names": ["Amazon\r"] },
    { "listing_source_names": ["Amazon\u00a0"] },
    { "listing_source_names": ["Amazon (unknown names are still valid constraints)"] }
  ],
  "invalid_constraints": [
    null,
    { "offer_types": null },
    { "offer_types": "physical_product" },
    { "offer_types": ["unknown"] },
    { "offer_types": ["physical_product", "physical_product"] },
    { "listing_source_names": null },
    { "listing_source_names": "Amazon" },
    { "listing_source_names": [null] },
    { "listing_source_names": ["Amazon", "Amazon"] },
    { "listing_source_names": ["\t\n\u000b\f\r "] },
    { "listing_source_kinds": ["marketplace"] }
  ],
  "codepoint_boundaries": {
    "accepted": 160,
    "rejected": 161,
    "supplementary_character": "😀"
  },
  "helper_patches": [
    { "constraints": { "offer_types": [] } },
    { "constraints": { "listing_source_names": [] } },
    { "constraints": { "offer_types": ["offline_service"] } },
    { "constraints": { "listing_source_names": ["Unknown but retained"] } }
  ],
  "invalid_helper_patches": [
    { "constraints": { "offer_types": null } },
    { "constraints": { "offer_types": ["unknown"] } },
    { "constraints": { "listing_source_names": null } },
    { "constraints": { "listing_source_names": [" "] } },
    { "constraints": { "listing_source_names": ["Amazon", "Amazon"] } },
    { "constraints": {} }
  ],
  "normative_examples": [
    {
      "id": "or-within-and-across",
      "offer_types": ["physical_product", "digital_goods"],
      "listing_source_names": ["Amazon", "AliExpress"],
      "expected_rule": "OR within each array and AND across dimensions; no preference by array order"
    },
    {
      "id": "ascii-name-equality",
      "left": " \tAmAzOn\r\n",
      "right": "amazon",
      "expected_rule": "equal after trimming U+0009-U+000D/U+0020 and folding ASCII A-Z"
    },
    {
      "id": "non-ascii-whitespace-is-significant",
      "left": "Amazon\u00a0",
      "right": "Amazon",
      "expected_rule": "not equal; NBSP is not trimmed"
    },
    {
      "id": "non-ascii-case-is-significant",
      "left": "Ämazon",
      "right": "ämazon",
      "expected_rule": "not equal; non-ASCII case is not folded"
    },
    {
      "id": "no-alias-or-substring-expansion",
      "filter": "Shopee",
      "other_name": "Shopee Singapore",
      "expected_rule": "not equal; no alias, locale-site, or substring expansion"
    },
    {
      "id": "unknown-remains-a-filter",
      "filter": "Future Marketplace",
      "expected_rule": "valid unknown names remain constraints and are not silently removed"
    },
    {
      "id": "invalid-public-values-do-not-match",
      "expected_rule": "enabled dimensions require a valid public offer_type or listing_source.name"
    },
    {
      "id": "hard-eligibility",
      "expected_rule": "force_offer and alternative_offers do not relax explicit filters"
    }
  ],
  "public_examples": [
    "../examples/http/offer-query-v1.0.json",
    "../examples/http/offer-provider-request-v1.0.json"
  ]
}
