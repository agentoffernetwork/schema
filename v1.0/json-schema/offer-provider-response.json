{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/offer-provider-response/v1.0",
  "title": "AgentOffer OfferProvider Response Schema v1.0",
  "description": "Adopted Partner supply success payload or channel error envelope. AON resolves Partner source identities and creates the public Query response separately.",
  "oneOf": [
    {
      "$ref": "#/$defs/successEnvelope"
    },
    {
      "$ref": "#/$defs/errorEnvelope"
    }
  ],
  "$defs": {
    "successEnvelope": {
      "type": "object",
      "description": "Partner-authored supply response for one AON OfferProvider request.",
      "required": [
        "request_id",
        "protocol_version",
        "language",
        "offers"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid",
          "description": "Exact request_id from the OfferProvider request."
        },
        "protocol_version": {
          "const": "1.0",
          "description": "Transport protocol line selected for this Partner response."
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z]{3}){0,3}(?:-[A-Za-z]{4})?(?:-(?:[A-Za-z]{2}|[0-9]{3}))?(?:-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(?:-[0-9A-WY-Za-wy-z](?:-[A-Za-z0-9]{2,8})+)*(?:-[Xx](?:-[A-Za-z0-9]{1,8})+)?$",
          "description": "Language of Partner-authored user-facing response content under the stable-v1.0 language profile."
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "https://agentoffernetwork.org/schema/offer-partner/v1.0"
          },
          "description": "Partner supply Offers. Each uses source_offer_id and never contains AON offer_id, offer_instance_id, or match_reason."
        },
        "flight_search": {
          "$ref": "https://agentoffernetwork.org/schema/offer-query-flight-profile/v1.0#/$defs/flightSearch",
          "description": "Execution metadata for a typed Flight Provider response."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "flight_search"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "offers": {
                "type": "array",
                "description": "Partner Flight supply with explicit price nature.",
                "items": {
                  "$ref": "https://agentoffernetwork.org/schema/offer-query-flight-profile/v1.0#/$defs/typedOffer",
                  "description": "Typed constraints in addition to the Partner Offer schema."
                }
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "errorEnvelope": {
      "type": "object",
      "required": [
        "code",
        "message",
        "data",
        "extra"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "RATE_LIMITED",
            "INTERNAL_ERROR"
          ],
          "description": "Stable machine-readable Partner channel error class."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error summary intended for integration diagnostics."
        },
        "data": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false,
          "description": "Reserved empty data object for the v1.0 Partner error envelope."
        },
        "extra": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional deployment-specific diagnostic metadata; it must not redefine code semantics.",
          "properties": {
            "flight_search_error": {
              "$ref": "https://agentoffernetwork.org/schema/offer-query-flight-profile/v1.0#/$defs/flightSearchError",
              "description": "Typed Flight error details; other diagnostic extensions remain available."
            }
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "extra": {
                "type": "object",
                "description": "Select an explicit Flight error diagnosis.",
                "required": [
                  "flight_search_error"
                ],
                "properties": {
                  "flight_search_error": {
                    "type": "object",
                    "description": "Select the Flight error class.",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "upstream_failure",
                        "description": "Flight error discriminator."
                      }
                    }
                  }
                }
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "code": {
                "const": "INTERNAL_ERROR",
                "description": "Required envelope code for this Flight error kind."
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "extra": {
                "type": "object",
                "description": "Select an explicit Flight error diagnosis.",
                "required": [
                  "flight_search_error"
                ],
                "properties": {
                  "flight_search_error": {
                    "type": "object",
                    "description": "Select the Flight error class.",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "invalid_query",
                        "description": "Flight error discriminator."
                      }
                    }
                  }
                }
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "code": {
                "const": "BAD_REQUEST",
                "description": "Required envelope code for this Flight error kind."
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "extra": {
                "type": "object",
                "description": "Select an explicit Flight error diagnosis.",
                "required": [
                  "flight_search_error"
                ],
                "properties": {
                  "flight_search_error": {
                    "type": "object",
                    "description": "Select the Flight error class.",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "const": "unsupported_capability",
                        "description": "Flight error discriminator."
                      }
                    }
                  }
                }
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "code": {
                "const": "BAD_REQUEST",
                "description": "Required envelope code for this Flight error kind."
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
