{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/offer-control/v1.0",
  "title": "AgentOffer Feedback and Watches Envelope v1.0",
  "description": "Canonical shared envelope for explicit user feedback and watch-control operations. Query may create or renew a default watch server-side; this envelope does not represent that automatic behavior. Runtime availability is deployment-owned.",
  "type": "object",
  "required": ["protocol_version", "target", "operation", "user_action", "idempotency_key"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["offer", "category"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "operation": {"type": "string", "enum": ["feedback", "watch", "unwatch"], "description": "watch is an explicit restore/re-enable action; unwatch cancels the default change-following behavior."},
    "user_action": {"const": "explicit"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "feedback": {"type": "string", "enum": ["dismissed", "not_interested"]}
  },
  "allOf": [
    {
      "if": {"type": "object", "properties": {"operation": {"const": "feedback"}}},
      "then": {"type": "object", "required": ["feedback"], "properties": {"target": {"type": "object", "properties": {"kind": {"const": "offer"}}}}}
    },
    {
      "if": {"type": "object", "properties": {"operation": {"enum": ["watch", "unwatch"]}}},
      "then": {"type": "object", "not": {"required": ["feedback"]}}
    }
  ],
  "additionalProperties": false
}
