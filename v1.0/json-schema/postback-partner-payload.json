{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/postback-partner-payload/v1.0",
  "title": "AgentOffer Provider-to-AON Postback Payload v1.0 (retired JSON body lane)",
  "description": "RETIRED (2026-10-08 in-place revision of postback v1.0). Describes the former JSON body lane selected by the AON-Protocol-Version request header; such requests now receive HTTP 410 postback_json_lane_retired. The only current Provider binding is GET /v1/postback/{partner_id} with query parameters, defined by the authoritative query parameter table in protocol/specs/postback-v1.0.md section 2.3. Retained for history and as the value-grammar reference for the shared field names.",
  "deprecated": true,
  "type": "object",
  "required": ["event_name"],
  "properties": {
    "event_name": {"$ref": "https://agentoffernetwork.org/schema/goal-event-name/v1.0"},
    "aon_click_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "aon_tracking_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "offer_instance_id": {"type": "string", "format": "uuid"},
    "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*", "x-aon-maxUtf8Bytes": 256},
    "order_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*", "x-aon-maxUtf8Bytes": 256},
    "partner_txn_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*", "x-aon-maxUtf8Bytes": 256}
  },
  "oneOf": [
    {"required": ["aon_click_id"], "not": {"anyOf": [{"required": ["aon_tracking_id"]}, {"required": ["offer_instance_id"]}]}},
    {"required": ["aon_tracking_id"], "not": {"anyOf": [{"required": ["aon_click_id"]}, {"required": ["offer_instance_id"]}]}},
    {"required": ["offer_instance_id"], "not": {"anyOf": [{"required": ["aon_click_id"]}, {"required": ["aon_tracking_id"]}]}}
  ],
  "dependentRequired": {"amount": ["currency"], "currency": ["amount"]},
  "additionalProperties": false
}
