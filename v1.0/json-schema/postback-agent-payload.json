{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/postback-agent-payload/v1.0",
  "title": "AgentOffer AON-to-Agent Conversion Webhook Payload v1.0",
  "description": "Frozen canonical webhook body. The protocol version is carried only by the HTTP header.",
  "type": "object",
  "required": ["event_id", "event_type", "event_name", "aon_tracking_id", "offer_id", "agent_id", "timestamp"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"const": "conversion"},
    "event_name": {"$ref": "https://agentoffernetwork.org/schema/goal-event-name/v1.0"},
    "aon_tracking_id": {"type": "string", "minLength": 1},
    "offer_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "amount": {"type": "number"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "sub_id": {"type": "string"},
    "sub_id_2": {"type": "string"},
    "sub_id_3": {"type": "string"},
    "sub_id_4": {"type": "string"},
    "sub_id_5": {"type": "string"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$"
    }
  },
  "dependentRequired": {"amount": ["currency"], "currency": ["amount"]},
  "additionalProperties": false
}
