  "$id": "https://agentoffernetwork.org/schema/postback-agent-payload/v1.0",
  "description": "Frozen canonical webhook body. The protocol version is carried only by the HTTP header.",
  "title": "AgentOffer AON-to-Agent Webhook Payload v1.0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "event_name",
        "offer_id",
        "application_id",
        "amount",
        "currency",
        "timestamp"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "const": "conversion"
        },
        "event_name": {
          "$ref": "https://agentoffernetwork.org/schema/goal-event-name/v1.0"
        },
