          "type": "string"
        },
        "sub_id_2": {
          "type": "string"
        },
        "sub_id_3": {
          "type": "string"
        },
        "sub_id_4": {
          "type": "string"
        },
        "sub_id_5": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$"
        }
      },
      "additionalProperties": false
    },
