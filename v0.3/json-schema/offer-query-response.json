{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/offer-query-response/v0.3",
  "title": "AgentOffer Query Response Schema v0.3",
  "description": "Adopted conversational Offer Query response with optional explanation and next-step guidance.",
  "type": "object",
  "required": ["request_id", "protocol_version", "language", "offers"],
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "protocol_version": {"const": "0.3"},
    "language": {"type": "string", "minLength": 1, "maxLength": 64},
    "offers": {"type": "array", "items": {"$ref": "https://agentoffernetwork.org/schema/offer/v0.3"}},
    "engagement": {"$ref": "#/$defs/engagement"},
    "hooks": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/hook"}},
    "empty_reason": {"type": "string", "enum": ["frequency_capped", "below_relevance_threshold", "scene_suppressed", "no_material", "consent_missing"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"type": "object", "properties": {"offers": {"type": "array", "maxItems": 0}}},
      "then": {"required": ["empty_reason"]}
    },
    {
      "if": {"type": "object", "properties": {"offers": {"type": "array", "minItems": 1}}},
      "then": {"not": {"required": ["empty_reason"]}}
    }
  ],
  "$defs": {
    "engagement": {"type": "object", "properties": {"refinements": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/refinement"}}, "followup_topics": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/followupTopic"}}}, "additionalProperties": false},
    "refinement": {"type": "object", "required": ["label", "query_helper"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 160}, "query_helper": {"$ref": "#/$defs/queryHelper"}, "speak": {"type": "string", "maxLength": 500}}, "additionalProperties": false},
    "followupTopic": {"type": "object", "required": ["label", "basis", "query_helper", "confidence"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 160}, "basis": {"type": "string", "enum": ["category_complement", "sequential_journey", "problem_to_product", "comparison_alternative", "user_interest", "seasonal"]}, "query_helper": {"$ref": "#/$defs/queryHelper"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "queryHelper": {"type": "object", "required": ["request_patch"], "properties": {"request_patch": {"type": "object", "properties": {"intent": {"type": "object", "properties": {"signals": {"$ref": "https://agentoffernetwork.org/schema/offer-query/v0.3#/$defs/signals"}}, "additionalProperties": false}, "constraints": {"$ref": "https://agentoffernetwork.org/schema/offer-query/v0.3#/$defs/constraints"}}, "additionalProperties": false}, "origin": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "https://agentoffernetwork.org/schema/offer-query/v0.3#/$defs/origin"}}}, "additionalProperties": false},
    "hook": {"type": "object", "required": ["kind", "title"], "properties": {"kind": {"type": "string", "enum": ["price_change", "availability_change", "eligibility_change", "content_change"]}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "description": {"type": "string", "maxLength": 500}, "query_helper": {"$ref": "#/$defs/queryHelper"}}, "additionalProperties": false}
  }
}
