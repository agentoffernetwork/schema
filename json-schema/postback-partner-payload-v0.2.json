{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentoffernetwork.org/schema/postback-partner-payload/v0.2",
  "title": "AgentOffer Partner-to-AON Conversion Payload v0.2",
  "description": "Decoded GET query or POST JSON payload for Partner conversion intake.",
  "type": "object",
  "required": ["event_name"],
  "properties": {
    "event_name": {
      "$ref": "https://agentoffernetwork.org/schema/goal-event-name/v0.2"
    },
    "offer_instance_id": {"type": "string", "minLength": 1},
    "aon_tracking_id": {"type": "string", "minLength": 1},
    "tracking_id": {"type": "string", "minLength": 1},
    "click_id": {"type": "string", "minLength": 1},
    "aon_click_id": {"type": "string", "minLength": 1},
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$"
    },
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "order_id": {"type": "string", "minLength": 1},
    "partner_txn_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1}
  },
  "anyOf": [
    {"required": ["offer_instance_id"]},
    {"required": ["aon_tracking_id"]},
    {"required": ["tracking_id"]},
    {"required": ["click_id"]},
    {"required": ["aon_click_id"]}
  ],
  "additionalProperties": false
}
